// ───────── CONFIG MÉTRICAS ─────────
const METRICA_CONFIG = {
  r_QDM:         { label: 'r',              titulo: 'Correlación r',                 min: -0.3, max: 0.5, ref: 0,   refLabel: 'cero' },
  hit_rate_QDM:  { label: 'Hit rate',       titulo: 'Hit rate',                       min: 0,    max: 0.7, ref: 0.333, refLabel: 'azar' },
  BSS_lower_QDM: { label: 'BSS lower',      titulo: 'BSS lower (tercil seco)',        min: -0.7, max: 0.3, ref: 0,   refLabel: 'climatología' },
  BSS_upper_QDM: { label: 'BSS upper',      titulo: 'BSS upper (tercil húmedo)',      min: -0.7, max: 0.3, ref: 0,   refLabel: 'climatología' },
  AUC_lower_QDM: { label: 'AUC lower',      titulo: 'AUC ROC lower (tercil seco)',    min: 0.3,  max: 0.9, ref: 0.5, refLabel: 'azar' },
  AUC_upper_QDM: { label: 'AUC upper',      titulo: 'AUC ROC upper (tercil húmedo)',  min: 0.3,  max: 0.9, ref: 0.5, refLabel: 'azar' },
};

let geojsonData = null;
let metricaActual = 'r_QDM';
let cuencaSeleccionada = null;

// ───────── COLOR SCALE ─────────
function colorScale(value, min, max) {
  if (value == null || isNaN(value)) return '#d1d5db';
  const t = Math.max(0, Math.min(1, (value - min) / (max - min)));
  // Gradient rojo → naranja → verde
  if (t < 0.5) {
    const u = t * 2;
    const r = Math.round(220 + (245-220)*u);
    const g = Math.round(38 + (158-38)*u);
    const b = Math.round(38 + (11-38)*u);
    return `rgb(${r},${g},${b})`;
  } else {
    const u = (t - 0.5) * 2;
    const r = Math.round(245 + (16-245)*u);
    const g = Math.round(158 + (185-158)*u);
    const b = Math.round(11 + (129-11)*u);
    return `rgb(${r},${g},${b})`;
  }
}

// ───────── CARGAR GEOJSON ─────────
async function cargarGeoJSON() {
  try {
    const resp = await fetch('cuencas.geojson');
    geojsonData = await resp.json();
    renderMapa();
  } catch (e) {
    document.getElementById('mapa-cuencas').innerHTML = 
      '<text x="-6" y="40" font-size="0.3" fill="#dc2626">Error cargando cuencas.geojson — comprueba que está al lado del .qmd</text>';
    console.error(e);
  }
}

// ───────── RENDER MAPA ─────────
function renderMapa() {
  if (!geojsonData) return;
  const svg = document.getElementById('mapa-cuencas');
  const cfg = METRICA_CONFIG[metricaActual];
  document.getElementById('metrica-titulo').textContent = cfg.titulo;
  document.getElementById('leyenda-min').textContent = cfg.min.toFixed(2);
  document.getElementById('leyenda-mid').textContent = ((cfg.min + cfg.max)/2).toFixed(2);
  document.getElementById('leyenda-max').textContent = cfg.max.toFixed(2);

  // Calcular extents de geojson para el viewBox
  let minLon=999, maxLon=-999, minLat=999, maxLat=-999;
  geojsonData.features.forEach(f => {
    const coords = f.geometry.type === 'MultiPolygon' 
      ? f.geometry.coordinates.flat(2)
      : f.geometry.coordinates.flat(1);
    coords.forEach(c => {
      if (c[0] < minLon) minLon = c[0];
      if (c[0] > maxLon) maxLon = c[0];
      if (c[1] < minLat) minLat = c[1];
      if (c[1] > maxLat) maxLat = c[1];
    });
  });
  // Padding
  const padX = (maxLon-minLon)*0.05;
  const padY = (maxLat-minLat)*0.05;
  svg.setAttribute('viewBox', `${minLon-padX} ${-maxLat-padY} ${maxLon-minLon+2*padX} ${maxLat-minLat+2*padY}`);

  let html = '';
  geojsonData.features.forEach(f => {
    const cod = f.properties.CodDemarc;
    const nombre = f.properties.Nombre;
    const datos = DATA_CUENCAS[cod];
    let color, hasData;
    if (datos) {
      const val = datos.medianas[metricaActual];
      color = colorScale(val, cfg.min, cfg.max);
      hasData = true;
    } else {
      color = '#d1d5db';
      hasData = false;
    }
    
    const polygons = f.geometry.type === 'MultiPolygon' 
      ? f.geometry.coordinates 
      : [f.geometry.coordinates];
    
    polygons.forEach(polyArr => {
      polyArr.forEach(ring => {
        // SVG usa Y invertido, así que negamos lat
        const path = ring.map((c, i) => 
          `${i===0?'M':'L'}${c[0]},${-c[1]}`
        ).join(' ') + 'Z';
        const selectedClass = (cuencaSeleccionada === cod) ? ' selected' : '';
        const dataClass = hasData ? '' : ' nodata';
        const titleTxt = hasData 
          ? `${nombre} — N=${datos.n_embalses}, ${cfg.label}=${datos.medianas[metricaActual]}`
          : `${nombre} — Sin datos`;
        html += `<path d="${path}" class="cuenca-poly${selectedClass}${dataClass}" 
                       fill="${color}" data-cod="${cod}" data-hasdata="${hasData}">
                   <title>${titleTxt}</title>
                 </path>`;
      });
    });
  });
  svg.innerHTML = html;
  
  // Listeners
  svg.querySelectorAll('.cuenca-poly').forEach(p => {
    p.addEventListener('click', () => {
      if (p.dataset.hasdata === 'true') {
        cuencaSeleccionada = p.dataset.cod;
        renderMapa();  // re-render para resaltar
        renderDetalle();
        renderTabla();
      }
    });
  });
}

// ───────── RENDER DETALLE ─────────
function renderDetalle() {
  const panel = document.getElementById('cuenca-detail');
  if (!cuencaSeleccionada || !DATA_CUENCAS[cuencaSeleccionada]) {
    panel.innerHTML = '<div class="cuenca-detail-placeholder">Haz clic en una cuenca del mapa para ver sus métricas detalladas</div>';
    return;
  }
  const d = DATA_CUENCAS[cuencaSeleccionada];
  const m = d.medianas;
  
  // Top 5 embalses por la métrica activa (descendente, excepto BS que es ascendente)
  const sorted = [...d.embalses].sort((a,b) => (b[metricaActual]||0) - (a[metricaActual]||0));
  const top = sorted.slice(0, 8);
  
  panel.innerHTML = `
    <div class="cuenca-detail-title">${d.nombre}</div>
    <div class="cuenca-detail-sub">${d.cod} · ${d.n_embalses} embalses</div>
    <div class="cuenca-detail-metrics">
      <div class="cuenca-detail-metric-card">
        <span class="cuenca-detail-metric-val" style="color:${rColor(m.r_QDM)}">${m.r_QDM.toFixed(2)}</span>
        <span class="cuenca-detail-metric-lbl">r mediana</span>
      </div>
      <div class="cuenca-detail-metric-card">
        <span class="cuenca-detail-metric-val" style="color:${hitColor(m.hit_rate_QDM)}">${(m.hit_rate_QDM*100).toFixed(1)}%</span>
        <span class="cuenca-detail-metric-lbl">Hit rate</span>
      </div>
      <div class="cuenca-detail-metric-card">
        <span class="cuenca-detail-metric-val" style="color:${bssColor(m.BSS_lower_QDM)}">${fmt2s(m.BSS_lower_QDM)}</span>
        <span class="cuenca-detail-metric-lbl">BSS lower (seco)</span>
      </div>
      <div class="cuenca-detail-metric-card">
        <span class="cuenca-detail-metric-val" style="color:${bssColor(m.BSS_upper_QDM)}">${fmt2s(m.BSS_upper_QDM)}</span>
        <span class="cuenca-detail-metric-lbl">BSS upper (húmedo)</span>
      </div>
      <div class="cuenca-detail-metric-card">
        <span class="cuenca-detail-metric-val" style="color:${aucColor(m.AUC_lower_QDM)}">${m.AUC_lower_QDM.toFixed(2)}</span>
        <span class="cuenca-detail-metric-lbl">AUC lower (seco)</span>
      </div>
      <div class="cuenca-detail-metric-card">
        <span class="cuenca-detail-metric-val" style="color:${aucColor(m.AUC_upper_QDM)}">${m.AUC_upper_QDM.toFixed(2)}</span>
        <span class="cuenca-detail-metric-lbl">AUC upper (húmedo)</span>
      </div>
    </div>
    <div class="cuenca-detail-rank">
      <div class="cuenca-detail-rank-title">Top embalses por ${METRICA_CONFIG[metricaActual].label}</div>
      <div class="cuenca-detail-list">
        ${top.map(e => `
          <div class="cuenca-detail-rank-row">
            <span class="cuenca-detail-rank-nombre">${e.nombre}</span>
            <span class="cuenca-detail-rank-val" style="color:${rColor(e[metricaActual])}">${(e[metricaActual]).toFixed(2)}</span>
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

// ───────── COLORES ─────────
function rColor(v)   { return v == null ? '#9ca3af' : v > 0.3 ? '#16a34a' : v > 0.15 ? '#ca8a04' : '#dc2626'; }
function hitColor(v) { return v == null ? '#9ca3af' : v > 0.45 ? '#16a34a' : v > 0.35 ? '#ca8a04' : '#dc2626'; }
function bssColor(v) { return v == null ? '#9ca3af' : v > 0.05 ? '#16a34a' : v > -0.05 ? '#ca8a04' : '#dc2626'; }
function aucColor(v) { return v == null ? '#9ca3af' : v > 0.65 ? '#16a34a' : v > 0.55 ? '#ca8a04' : '#dc2626'; }
function fmt2s(v) { if (v == null) return '—'; return (v >= 0 ? '+' : '') + v.toFixed(2); }

// ───────── BOXPLOTS ─────────
function renderBoxplots() {
  const svg = document.getElementById('boxplots-cuencas');
  const W = 1100, H = 380;
  const metricas = ['r_QDM', 'hit_rate_QDM', 'BSS_lower_QDM', 'BSS_upper_QDM', 'AUC_lower_QDM', 'AUC_upper_QDM'];
  const cuencasOrden = Object.keys(DATA_CUENCAS).sort((a,b) => 
    (DATA_CUENCAS[b].medianas.r_QDM || -999) - (DATA_CUENCAS[a].medianas.r_QDM || -999)
  );
  
  const panelW = (W - 60) / metricas.length;
  const panelH = H - 80;
  const top = 30;
  const leftMargin = 50;
  
  let html = '';
  metricas.forEach((metrica, mi) => {
    const cfg = METRICA_CONFIG[metrica];
    const px = leftMargin + mi * panelW;
    const py = top;
    
    // Título panel
    html += `<text x="${px + panelW/2}" y="${py - 12}" text-anchor="middle" class="box-title">${cfg.label}</text>`;
    
    // Eje Y
    const yMin = cfg.min, yMax = cfg.max;
    const yScale = v => py + panelH - ((v - yMin) / (yMax - yMin)) * panelH;
    
    // Línea referencia
    const refY = yScale(cfg.ref);
    html += `<line x1="${px+10}" y1="${refY}" x2="${px+panelW-10}" y2="${refY}" class="box-ref-line"/>`;
    
    // Ticks eje Y solo en primer panel
    if (mi === 0) {
      const nTicks = 5;
      for (let i = 0; i <= nTicks; i++) {
        const v = yMin + (yMax - yMin) * i / nTicks;
        const y = yScale(v);
        html += `<line x1="${px-3}" y1="${y}" x2="${px}" y2="${y}" stroke="#9ca3af" stroke-width="0.5"/>`;
        html += `<text x="${px-6}" y="${y+3}" text-anchor="end" class="box-axis-label">${v.toFixed(2)}</text>`;
      }
    }
    
    // Box por cuenca
    const boxW = (panelW - 20) / cuencasOrden.length * 0.7;
    cuencasOrden.forEach((cod, ci) => {
      const cx = px + 10 + (ci + 0.5) * ((panelW - 20) / cuencasOrden.length);
      const vals = DATA_CUENCAS[cod].valores[metrica].filter(v => !isNaN(v));
      if (vals.length === 0) return;
      
      vals.sort((a,b) => a-b);
      const q1 = vals[Math.floor(vals.length * 0.25)];
      const q2 = vals[Math.floor(vals.length * 0.5)];
      const q3 = vals[Math.floor(vals.length * 0.75)];
      const iqr = q3 - q1;
      const whLow = Math.max(vals[0], q1 - 1.5*iqr);
      const whHigh = Math.min(vals[vals.length-1], q3 + 1.5*iqr);
      
      const yQ1 = yScale(q1), yQ2 = yScale(q2), yQ3 = yScale(q3);
      const yWL = yScale(whLow), yWH = yScale(whHigh);
      
      // Caja
      html += `<rect x="${cx - boxW/2}" y="${yQ3}" width="${boxW}" height="${yQ1-yQ3}" class="box-rect">
                 <title>${DATA_CUENCAS[cod].nombre} (N=${vals.length}) Q1=${q1.toFixed(2)} Q2=${q2.toFixed(2)} Q3=${q3.toFixed(2)}</title>
               </rect>`;
      // Mediana
      html += `<line x1="${cx - boxW/2}" y1="${yQ2}" x2="${cx + boxW/2}" y2="${yQ2}" class="box-median"/>`;
      // Bigotes
      html += `<line x1="${cx}" y1="${yWL}" x2="${cx}" y2="${yQ1}" class="box-whisker"/>`;
      html += `<line x1="${cx}" y1="${yWH}" x2="${cx}" y2="${yQ3}" class="box-whisker"/>`;
      html += `<line x1="${cx - boxW*0.3}" y1="${yWL}" x2="${cx + boxW*0.3}" y2="${yWL}" class="box-whisker"/>`;
      html += `<line x1="${cx - boxW*0.3}" y1="${yWH}" x2="${cx + boxW*0.3}" y2="${yWH}" class="box-whisker"/>`;
      
      // Outliers
      vals.forEach(v => {
        if (v < whLow || v > whHigh) {
          html += `<circle cx="${cx}" cy="${yScale(v)}" r="2" class="box-outlier"/>`;
        }
      });
      
      // Etiqueta cuenca (rotada) en último panel
      if (mi === metricas.length - 1) {
        // No, lo ponemos abajo de todos pero solo si la tira es la última
      }
    });
  });
  
  // Etiquetas de cuencas en X
  cuencasOrden.forEach((cod, ci) => {
    const cuenca = DATA_CUENCAS[cod];
    const nombreCorto = cuenca.nombre.split(' ')[0].substr(0, 7);
    const px = leftMargin;
    const cx = px + 10 + (ci + 0.5) * ((W - leftMargin - 10 - leftMargin - 10) / cuencasOrden.length / metricas.length * metricas.length);
    // Mejor: colocar bajo cada panel
  });
  
  // Leyenda de cuencas debajo
  const legY = H - 40;
  const legX = leftMargin;
  const legColW = (W - leftMargin) / cuencasOrden.length;
  cuencasOrden.forEach((cod, ci) => {
    const x = legX + ci * legColW + 5;
    const c = DATA_CUENCAS[cod];
    const nombreCorto = c.nombre.length > 12 ? c.nombre.substr(0, 10) + '…' : c.nombre;
    html += `<text x="${x}" y="${legY}" class="box-axis-label" style="font-size:9px">${ci+1}. ${nombreCorto}</text>`;
    html += `<text x="${x}" y="${legY+12}" class="box-axis-label" style="font-size:8px;fill:#6b7280">N=${c.n_embalses}</text>`;
  });
  
  svg.innerHTML = html;
  
  // Mejor solución: indices numéricos arriba de cada box
  // Rehago añadiendo índice arriba
  metricas.forEach((metrica, mi) => {
    const px = leftMargin + mi * panelW;
    const panelW_ = panelW;
    cuencasOrden.forEach((cod, ci) => {
      const cx = px + 10 + (ci + 0.5) * ((panelW_ - 20) / cuencasOrden.length);
      const idxText = svg.ownerDocument.createElementNS('http://www.w3.org/2000/svg', 'text');
      idxText.setAttribute('x', cx);
      idxText.setAttribute('y', top + panelH + 12);
      idxText.setAttribute('text-anchor', 'middle');
      idxText.setAttribute('class', 'box-axis-label');
      idxText.style.fontSize = '8px';
      idxText.textContent = ci + 1;
      svg.appendChild(idxText);
    });
  });
}

// ───────── TABLA ─────────
function renderTabla() {
  const tbody = document.querySelector('#tabla-cuencas tbody');
  const sorted = Object.values(DATA_CUENCAS).sort((a,b) => b.medianas.r_QDM - a.medianas.r_QDM);
  tbody.innerHTML = sorted.map(d => `
    <tr data-cod="${d.cod}" class="${d.cod === cuencaSeleccionada ? 'selected-row' : ''}">
      <td><strong>${d.nombre}</strong></td>
      <td>${d.n_embalses}</td>
      <td class="metrica" style="color:${rColor(d.medianas.r_QDM)}">${d.medianas.r_QDM.toFixed(2)}</td>
      <td class="metrica" style="color:${hitColor(d.medianas.hit_rate_QDM)}">${(d.medianas.hit_rate_QDM*100).toFixed(1)}%</td>
      <td class="metrica" style="color:${bssColor(d.medianas.BSS_lower_QDM)}">${fmt2s(d.medianas.BSS_lower_QDM)}</td>
      <td class="metrica" style="color:${bssColor(d.medianas.BSS_upper_QDM)}">${fmt2s(d.medianas.BSS_upper_QDM)}</td>
      <td class="metrica" style="color:${aucColor(d.medianas.AUC_lower_QDM)}">${d.medianas.AUC_lower_QDM.toFixed(2)}</td>
      <td class="metrica" style="color:${aucColor(d.medianas.AUC_upper_QDM)}">${d.medianas.AUC_upper_QDM.toFixed(2)}</td>
    </tr>
  `).join('');
  tbody.querySelectorAll('tr').forEach(r => {
    r.addEventListener('click', () => {
      cuencaSeleccionada = r.dataset.cod;
      renderMapa();
      renderDetalle();
      renderTabla();
    });
  });
}

// ───────── INIT ─────────
document.getElementById('sel-metrica').addEventListener('change', e => {
  metricaActual = e.target.value;
  renderMapa();
  if (cuencaSeleccionada) renderDetalle();
});

cargarGeoJSON();
renderBoxplots();
renderTabla();
</script>
```
